ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-value
BACKEND_CORS_ORIGINS=https://app.example.com

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=job
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=job

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_DB=0

ES_ENABLED=false

# Keep disabled until an explicit rollout is approved. The frontend build reads
# AGENT_ENABLED from this production configuration during release, while the
# backend additionally enforces the percentage and allow-list below.
AGENT_ENABLED=false
AGENT_ROLLOUT_PERCENT=0
AGENT_ROLLOUT_USER_IDS=

AI_PROVIDER=replace-with-approved-provider
AI_BASE_URL=https://api.example.com
AI_API_KEY=replace-with-an-api-key
AI_MODEL=replace-with-approved-model

ALIPAY_PRIVATE_KEY_PATH=/opt/job/certs/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/opt/job/certs/alipay_public_key.pem
WECHAT_PRIVATE_KEY_PATH=/opt/job/certs/wechat_private_key.pem
